.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos del sistema
.DS_Store
Thumbs.db

# VS Code
.vscode/

# Cobertura de tests
# Se ignora el informe entero menos los dos archivos de totales: el proyecto
# los entrega como evidencia, y leerlos del repositorio evita tener que
# reproducir el pipeline para saber en cuanto esta la cobertura.
# Nota: se ignora el CONTENIDO (coverage/*) y no la carpeta (coverage/), porque
# git no entra en un directorio ignorado y las excepciones no se aplicarian.
coverage/*
!coverage/coverage-summary.json
!coverage/lcov.info

# Builds
dist/
build/

# Archivos temporales
*.tmp
*.temp
# Configuracion local generada desde config.example.js
config.js

# Variables de entorno locales
.env
