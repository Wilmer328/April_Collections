# Variables de entorno de April Collections
#
# Copia este archivo como .env (ignorado por Git) para desarrollo local.
# En produccion se definen en Vercel: Settings -> Environment Variables.
#
# Supabase -> Project Settings -> API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ATENCION: la service_role key NUNCA va aqui ni en ninguna variable VITE_*,
# porque todo lo que empieza con VITE_ se incrusta en el paquete que descarga
# el navegador. Su unico uso previsto es dentro de funciones serverless.
